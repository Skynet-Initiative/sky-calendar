{
  "name": "@sky-calendar/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && concurrently -k -n tsc,bun -c yellow,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"bun --watch dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "bun dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "bun scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.2",
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-fastify": "11.1.24",
    "@nestjs/throttler": "6.5.0",
    "@skynet-initiative/sky-calendar-contracts": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "fastify": "5.12.4",
    "jose": "6.2.3",
    "pg": "8.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "@types/pg": "8.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
