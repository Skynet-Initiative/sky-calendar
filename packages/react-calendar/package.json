{
  "name": "@skynet-initiative/sky-calendar",
  "version": "0.1.0",
  "description": "Skynet calendar UI and headless scheduling core: timezone-safe views, RFC 5545 recurrence and accessible interactions.",
  "keywords": [
    "react",
    "react-19",
    "calendar",
    "scheduler",
    "timeline",
    "resource-scheduler",
    "recurrence",
    "rrule",
    "timezone",
    "nextjs",
    "ssr",
    "oklch",
    "theme-agnostic",
    "drag-and-drop",
    "accessibility"
  ],
  "license": "MIT",
  "author": "Skynet Initiative; based on work by Ascentspark Software Private Limited",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skynet-Initiative/sky-calendar.git",
    "directory": "packages/react-calendar"
  },
  "homepage": "https://github.com/Skynet-Initiative/sky-calendar#readme",
  "bugs": {
    "url": "https://github.com/Skynet-Initiative/sky-calendar/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./date-fns": {
      "types": "./dist/date-fns.d.ts",
      "import": "./dist/date-fns.js"
    },
    "./recurrence": {
      "types": "./dist/recurrence.d.ts",
      "import": "./dist/recurrence.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:perf": "RUN_PERF_BENCHMARKS=1 vitest run src/core/view-model/perf-bench.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "date-fns": "4.1.0",
    "date-fns-tz": "3.2.0",
    "rrule": "2.8.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "fast-check": "4.9.0",
    "jsdom": "26.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
