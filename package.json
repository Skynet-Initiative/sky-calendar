{
  "name": "@skynet-initiative/sky-calendar-workspace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c cyan,green \"bun --filter @sky-calendar/frontend dev\" \"bun --filter @sky-calendar/backend dev\"",
    "build": "bun run build:contracts && bun run build:calendar && bun run build:frontend && bun run build:backend",
    "build:contracts": "bun --filter @skynet-initiative/sky-calendar-contracts build",
    "build:calendar": "bun --filter @skynet-initiative/sky-calendar build && bun scripts/check-bundle-size.mjs",
    "build:frontend": "bun --filter @sky-calendar/frontend build",
    "build:backend": "bun --filter @sky-calendar/backend build",
    "typecheck": "bun run build:contracts && bun run build:calendar && bun --filter '*' typecheck",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx}\" --max-warnings=0",
    "test": "bun run build:contracts && bun --filter @skynet-initiative/sky-calendar test && bun --filter @skynet-initiative/sky-calendar-contracts test && bun --filter @sky-calendar/backend test && bun --filter @sky-calendar/frontend test",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "db:migrate": "bun --filter @sky-calendar/backend db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.5.1",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "fastify": "5.12.4",
    "find-my-way": "9.9.0"
  }
}
